# Copy to .env (local). EXPO_PUBLIC_* values are inlined into the app bundle at build time,
# so only public keys go here. Secret keys go in .env.secrets (never loaded by Expo).
#
# Release builds (Xcode Release / Android release) and the production website use
# production Supabase + the LIVE publishable key. Debug builds (__DEV__) use the staging
# Supabase project + the TEST key; without staging they fall back to production + LIVE.

EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST=pk_test_...

EXPO_PUBLIC_SUPABASE_URL_DEV=https://<staging-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY_DEV=
