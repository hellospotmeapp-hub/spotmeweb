# Copy to .env (local) and set the same variables in Vercel → Project → Settings → Environment Variables.
# EXPO_PUBLIC_* values are inlined into the web bundle at build time, so only put public keys here.

# Stripe publishable key. Must match the mode of the STRIPE_SECRET_KEY secret on the Supabase `api` function:
#   test: pk_test_...  with  sk_test_...
#   live: pk_live_...  with  sk_live_...
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
