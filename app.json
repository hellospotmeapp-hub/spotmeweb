{
  "expo": {
    "name": "SpotMeOne",
    "slug": "support-contribute-community",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "support-contribute-community",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.spotmeone.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "SpotMeOne needs camera access to take photos for your needs and profile.",
        "NSPhotoLibraryUsageDescription": "SpotMeOne needs photo library access to attach images to your needs and update your profile picture.",
        "NSPhotoLibraryAddUsageDescription": "SpotMeOne needs permission to save receipt images to your photo library.",
        "LSApplicationQueriesSchemes": [
          "spotme",
          "stripe"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": []
      },
      "buildNumber": "26"
    },
    "android": {
      "package": "com.spotmeone.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFA900"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFA900"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SpotMeOne needs access to your photos to attach images to needs.",
          "cameraPermission": "SpotMeOne needs camera access to take photos for your needs.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "56c34e83-706e-4b0a-a3a6-eae5e8d22f97"
      }
    }
  }
}
